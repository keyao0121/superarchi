// Build and run through `bun run acde:build` / `acde:dev` / `acde:test` / `acde:install`, not bare
// `acde …`: they set PASCAL_PORTABLE_BUILD=1, without which images stay optimized in the bundle.
// acde:test runs one worker: each worker runs `next build`, and they would share `.next`. It runs
// in English, whatever the machine's language: the app opens in the session's language under acde,
// and the tests find controls by their English names.
{
  "$schema": "../../node_modules/@dopame/acde-api/config.schema.json",
  "type": "app",
  "id": "pascal-editor",
  "label": "Pascal Editor",
  "icon": "app",
  "framework": "next",
  "size": [1440, 900],
  // The 256 MB default is too small for the 3D editor.
  "heapMb": 2048,
  "capabilities": { "fs": true }
}
